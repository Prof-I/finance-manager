-.top h1 { margin: 0 0 .75rem; font-size: 1.5rem; letter-spacing: -.01em; }
+.top-bar { display: flex; justify-content: space-between; align-items: center; gap: .75rem; margin-bottom: .75rem; }
+.top h1 { margin: 0; font-size: 1.5rem; letter-spacing: -.01em; }
